# ============================================================
# Free-tier API keys. Copy this file to .env and fill in keys.
# NEVER commit the real .env file. It is git-ignored.
# ============================================================

# Grok (xAI free tier) — used for NLP: JD distilling, resume rephrasing
XAI_API_KEY=your_xai_free_tier_key_here

# Gemini free tier — used for embeddings (text-embedding-004)
# Set via the standard env var the Gemini client reads.
GOOGLE_API_KEY=your_google_free_tier_key_here

# Optional: if you route Gemini through an OpenAI-compatible endpoint
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...

# NOTE: No paid services. If a key is missing, the system falls back
# to deterministic rules and produces a usable (less-tailored) result.
